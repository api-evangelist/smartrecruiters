{
  "opencollection": "1.0.0",
  "info": {
    "name": "SmartRecruiters Candidate Applications Teams API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-SmartToken",
      "value": "{{X-SmartToken}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Job Hiring Team",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.smartrecruiters.com/jobs/:jobId/hiring-team",
            "params": [
              {
                "name": "jobId",
                "value": "",
                "type": "path",
                "description": "The unique job identifier"
              }
            ]
          },
          "docs": "Returns the hiring team members assigned to a specific job."
        }
      ]
    }
  ],
  "bundled": true
}